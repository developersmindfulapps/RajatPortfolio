# Copy this file to .env.local and fill in your real values.
# DO NOT commit .env.local to source control.

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Cloudflare Turnstile secret key — found in Turnstile dashboard (used server-side only)
TURNSTILE_SECRET_KEY=xxxxxxxx

# Cloudflare Turnstile site key — found in Turnstile dashboard (safe to expose publicly)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=xxxxxxxx

# Email address that receives contact form submissions
CONTACT_EMAIL=developers.mindfulapps@gmail.com

# MongoDB Atlas Database integration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_DB_NAME=PersonalPortfolio
